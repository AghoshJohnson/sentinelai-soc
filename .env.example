# ============================================================
# AI SOC Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.
# ============================================================

# ── Ollama (local LLM — required for AI analysis) ────────────
# Base URL of your running Ollama instance.
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for analysis. Must be pulled first:
#   ollama pull mistral        (recommended: fast, 4GB)
#   ollama pull llama3         (best quality, 8GB+)
#   ollama pull phi3           (lightweight, 2GB)
OLLAMA_MODEL=mistral

# Request timeout in seconds. Increase for slower hardware.
OLLAMA_TIMEOUT=120

# Max tokens in the AI response.
OLLAMA_MAX_TOKENS=2048

# Sampling temperature: lower = more deterministic (0.0–1.0).
OLLAMA_TEMPERATURE=0.2

# ── AbuseIPDB (optional IP reputation enrichment) ────────────
# Get a free API key at https://www.abuseipdb.com/register
# Leave empty to disable IP enrichment entirely.
ABUSEIPDB_API_KEY=

# How far back to look for abuse reports (days).
ABUSEIPDB_MAX_AGE_DAYS=90

# ── Output paths ─────────────────────────────────────────────
# Default directory for saved reports (JSON + TXT).
# Can be overridden via --output-dir on the CLI.
REPORT_OUTPUT_DIR=outputs/reports
